apiVersion: run.googleapis.com/v1
kind: Job
metadata:
  name: urithiru
spec:
  template:
    spec:
      taskCount: 1
      parallelism: 1
      template:
        spec:
          serviceAccountName: ${SERVICE_ACCOUNT}
          maxRetries: 0
          timeoutSeconds: 86400
          # Cloud Run sandboxes are a Preview feature. Until the project is allowlisted the
          # API rejects this field outright, so it ships commented out: uncomment it once
          # `sandboxLauncher` is accepted in your region and the orchestrator will isolate
          # every agent in gVisor. Without it the run still completes, logging
          # `sandbox_unavailable` with `isolation=container` -- see docs/google.md.
          # sandboxLauncher: gvisor
          containers:
            - image: ${IMAGE_URI}
              # Every execution overrides these; the defaults must never do useful work.
              args: ["orchestrate", "--run", "OVERRIDDEN-AT-SUBMIT"]
              # No agent credential is passed in. The agent authenticates with this
              # job's own Application Default Credentials, so nothing to store or leak.
              resources:
                limits:
                  # The orchestrator hosts every agent. A step runs its search and code
                  # sandboxes at once, so size for 2 x search.parallelism concurrent agents.
                  cpu: "8"
                  memory: 16Gi

