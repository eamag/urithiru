apiVersion: run.googleapis.com/v1
kind: Job
metadata:
  name: urithiru
spec:
  template:
    spec:
      taskCount: 1
      parallelism: 1
      template:
        spec:
          serviceAccountName: ${SERVICE_ACCOUNT}
          maxRetries: 0
          timeoutSeconds: 86400
          # Generated code runs in a Cloud Run sandbox launched from inside this container.
          sandboxLauncher: gvisor
          containers:
            - image: ${IMAGE_URI}
              # Every execution overrides these; the defaults must never do useful work.
              args: ["orchestrate", "--run", "OVERRIDDEN-AT-SUBMIT"]
              env:
                - name: GEMINI_API_KEY
                  valueFrom:
                    secretKeyRef:
                      key: latest
                      name: urithiru-gemini-api-key
              resources:
                limits:
                  # The orchestrator hosts every agent. A step runs its search and code
                  # sandboxes at once, so size for 2 x search.parallelism concurrent agents.
                  cpu: "8"
                  memory: 16Gi

